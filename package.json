{
  "name": "claudemd-cli",
  "version": "0.58.1",
  "description": "Standalone CLI for §10-V banned-vocab + transcript scanning. Companion to the claudemd Claude Code plugin (github.com/sdsrss/claudemd) for use in git pre-commit hooks, GitHub Actions, and other agents.",
  "type": "module",
  "bin": {
    "claudemd-cli": "bin/claudemd-lint.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sdsrss/claudemd.git"
  },
  "homepage": "https://github.com/sdsrss/claudemd#standalone-cli-v090-r-n7",
  "bugs": "https://github.com/sdsrss/claudemd/issues",
  "keywords": [
    "lint",
    "claude",
    "claude-code",
    "banned-vocab",
    "commit-hook",
    "transcript-audit",
    "spec-enforcement"
  ],
  "scripts": {
    "test": "bash tests/run-all.sh",
    "test:scripts": "bash -c 'source tests/lib/env-hygiene.sh && claudemd_reset_test_env && node --test tests/scripts/*.test.js'",
    "test:hooks": "for t in tests/hooks/*.test.sh; do bash \"$t\" || exit 1; done",
    "lint:argv": "node scripts/lint-argv.js",
    "version-check": "node scripts/version-cascade-check.js"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
