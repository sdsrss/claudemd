-Run: `CLAUDEMD_SAMPLING_DAYS=${ARGS:-30} node ${CLAUDE_PLUGIN_ROOT}/scripts/sampling-audit.js`
+Run: `node ${CLAUDE_PLUGIN_ROOT}/scripts/sampling-audit.js [--days=N] [flags]`
 
